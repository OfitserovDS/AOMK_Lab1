 * </author>
 *
 */

import "IEcoBase1.idl";

/* Типы граничных условий сплайна */
typedef [public] enum ECO_SPLINE_END_TYPE {
    ECO_SPLINE_END_NOT_A_KNOT        = 0,   /* S''' непрерывна в x[1] и x[n-2] (по умолчанию, как в MATLAB) */
    ECO_SPLINE_END_NATURAL           = 1,   /* S'' = 0 на конце (естественный сплайн) */
    ECO_SPLINE_END_FIRST_DERIVATIVE  = 2,   /* задано значение S' на конце (clamped) */
    ECO_SPLINE_END_SECOND_DERIVATIVE = 3    /* задано значение S'' на конце */
} ECO_SPLINE_END_TYPE;

/* Граничные условия на левом (x[0]) и правом (x[n-1]) концах */
typedef [public] struct ECO_SPLINE_ENDS_T {
    uint16_t  leftType;
    uint16_t  rightType;
    ldouble_t leftValue;
    ldouble_t rightValue;
} ECO_SPLINE_ENDS_T;

[
    object,
    uuid(B0ED03B2-1831-4747-8635-F0C9191A7C2B),
    pointer_default(unique)
]
interface IEcoSpline : IEcoUnknown {

    uint32_t get_Pieces();
    int16_t get_Breaks([out, size_is(size)] double_t* pBreaks, [in] uint32_t size);
    int16_t get_Coefs([out, size_is(size)] double_t* pCoefs, [in] uint32_t size);
    int16_t Evaluate([in, size_is(m)] const double_t* xq, [in] uint32_t m, [out, size_is(m)] double_t* yq);
    int16_t EvaluateDerivative([in] uint32_t order, [in, size_is(m)] const double_t* xq, [in] uint32_t m, [out, size_is(m)] double_t* yq);
    int16_t Integrate([in] double_t a, [in] double_t b, [out] double_t* pResult);
};

[
    object,
    uuid(A8A4C017-2F92-46D4-A3F7-870EAC1CDCB6),
    pointer_default(unique)
]
interface IEcoAdvancedMath : IEcoUnknown {

    int16_t spline([in, size_is(n)] const double_t* x, [in, size_is(n)] const double_t* y, [in] uint32_t n,
                   [in, unique] const ECO_SPLINE_ENDS_T* pEnds,
                   [in, size_is(m)] const double_t* xq, [in] uint32_t m, [out, size_is(m)] double_t* yq);

    int16_t splinef([in, size_is(n)] const float_t* x, [in, size_is(n)] const float_t* y, [in] uint32_t n,
                    [in, unique] const ECO_SPLINE_ENDS_T* pEnds,
                    [in, size_is(m)] const float_t* xq, [in] uint32_t m, [out, size_is(m)] float_t* yq);

    int16_t splinel([in, size_is(n)] const ldouble_t* x, [in, size_is(n)] const ldouble_t* y, [in] uint32_t n,
                    [in, unique] const ECO_SPLINE_ENDS_T* pEnds,
                    [in, size_is(m)] const ldouble_t* xq, [in] uint32_t m, [out, size_is(m)] ldouble_t* yq);

    int16_t new_Spline([in, size_is(n)] const double_t* x, [in, size_is(n)] const double_t* y, [in] uint32_t n,
                       [in, unique] const ECO_SPLINE_ENDS_T* pEnds,
                       [out] IEcoSpline** ppISpline);
};
