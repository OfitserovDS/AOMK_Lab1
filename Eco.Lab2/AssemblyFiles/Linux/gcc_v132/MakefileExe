# --- Host Platform Detection ---
ifeq ($(OS), Windows_NT)
    RM = -del /q /f
    SLASH = /
    ECO_TOOLCHAIN_ENV := $(if $(ECO_TOOLCHAIN),$(subst \,/,$(ECO_TOOLCHAIN)),)
else
    RM = rm -f
    SLASH = /
    ECO_TOOLCHAIN_ENV := $(ECO_TOOLCHAIN)
endif

# --- Project Configuration ---
TARGET ?= 1
DEVICE ?= D1
ARCH ?= x86_64
DEBUG ?= 0
PLATFORM = Linux

# --- Toolchain, Path and Architecture Selection ---
ifeq ($(ARCH), x86_64)
    CCFLAGS_ARCH = -DECO_X86_64
    ARCH_TARGET = x86_64
    ECO_PKG_ID = eco-x86_64-linux-gnu-gcc
    ECO_PKG_VER = 13.2.0
    ECO_GEN_SYS_LIB = 00000000000000000000000053595333
    ifneq ($(ECO_TOOLCHAIN_ENV),)
        TOOL = x86_64-linux-gnu-
    endif
else ifeq ($(ARCH), x86_32)
    CCFLAGS_ARCH = -DECO_X86_32 -m32
    ARCH_TARGET = x86_32
    ECO_PKG_ID = eco-x86_32-linux-gnu-gcc
    ECO_PKG_VER = 13.2.0
    ECO_GEN_SYS_LIB = 00000000000000000000000053595332
    ifneq ($(ECO_TOOLCHAIN_ENV),)
        TOOL = i386-linux-gnu-
    endif
else ifeq ($(ARCH), rv64)
    CCFLAGS_ARCH = -DECO_RISCV_64
    ARCH_TARGET = rv64
    ECO_PKG_ID = eco-riscv64-linux-gnu-gcc
    ECO_PKG_VER = 13.2.0
    ECO_GEN_SYS_LIB = 00000000000000000000000053595333
    ifneq ($(ECO_TOOLCHAIN_ENV),)
        TOOL = riscv64-linux-gnu-
    endif
else ifeq ($(ARCH), aarch64)
    CCFLAGS_ARCH = -DECO_AARCH64
    ARCH_TARGET = armv8
    ECO_PKG_ID = eco-aarch64-linux-gnu-gcc
    ECO_PKG_VER = 13.2.0
    ECO_GEN_SYS_LIB = 00000000000000000000000053595333
    ifneq ($(ECO_TOOLCHAIN_ENV),)
        TOOL = aarch64-linux-gnu-
    endif
else
    $(error Unknown ARCH: $(ARCH). Please check your ARCH variable)
endif

ifneq ($(ECO_TOOLCHAIN_ENV),)
    TOOLCHAIN_SUBDIR = $(if $(ECO_PKG_ID),$(ECO_PKG_ID)-$(ECO_PKG_VER)$(SLASH),)
    TOOLCHAIN = $(ECO_TOOLCHAIN_ENV)$(SLASH)$(TOOLCHAIN_SUBDIR)bin$(SLASH)
    SYSROOT = --sysroot=$(ECO_TOOLCHAIN_ENV)$(SLASH)$(TOOLCHAIN_SUBDIR)
else
    TOOL =
    TOOLCHAIN =
    SYSROOT =
endif

# --- Tool Definitions ---
CC_c = $(TOOLCHAIN)$(TOOL)gcc
CC_cpp = $(TOOLCHAIN)$(TOOL)g++
AR = $(TOOLCHAIN)$(TOOL)gcc-ar
LD = $(TOOLCHAIN)$(TOOL)ld
OC = $(TOOLCHAIN)$(TOOL)objcopy

LANG_STD_c = -std=c89
LANG_STD_cpp = -std=c++11

CC = $(CC_c)
LINK_CC = $(CC_c)
LANG_STD_FLAGS = $(LANG_STD_c)

# --- Target Configuration (Static vs Dynamic) ---
ifeq ($(TARGET), 1)
    # Static Link
    BASE_TARGET = Static
    CCFLAGS_BASE = -DECO_LIB
else
    # Dynamic Link
    BASE_TARGET = Dynamic
    CCFLAGS_BASE = -DECO_DLL
endif

# --- Output Directory Mapping ---
CONFIG_DIR = $(if $(filter 1,$(DEBUG)),Debug,Release)
OUT_DIR = ..$(SLASH)..$(SLASH)..$(SLASH)BuildFiles$(SLASH)$(PLATFORM)$(SLASH)$(ARCH_TARGET)$(SLASH)$(BASE_TARGET)$(CONFIG_DIR)
OUT_NAME = EcoLab2

# --- Compilation Flags ---
# Includes: заголовки Eco.Lab2, Eco.AdvancedMath (корень репозитория) и калькуляторов курса
INC = -I "$(ECO_FRAMEWORK)$(SLASH)Eco.Core1$(SLASH)SharedFiles" \
-I "$(ECO_FRAMEWORK)$(SLASH)Eco.InterfaceBus1$(SLASH)SharedFiles" \
-I "$(ECO_FRAMEWORK)$(SLASH)Eco.MemoryManager1$(SLASH)SharedFiles" \
-I "$(ECO_FRAMEWORK)$(SLASH)Eco.FileSystemManagement1$(SLASH)SharedFiles" \
-I "$(ECO_FRAMEWORK)$(SLASH)Eco.System1$(SLASH)SharedFiles" \
-I ..$(SLASH)..$(SLASH)..$(SLASH)SharedFiles$(SLASH) \
-I ..$(SLASH)..$(SLASH)..$(SLASH)HeaderFiles$(SLASH) \
-I ..$(SLASH)..$(SLASH)..$(SLASH)HeaderFiles$(SLASH)$(ARCH) \
-I ..$(SLASH)..$(SLASH)..$(SLASH)UnitTestFiles$(SLASH)HeaderFiles \
-I ..$(SLASH)..$(SLASH)..$(SLASH)..$(SLASH)SharedFiles \
-I ..$(SLASH)..$(SLASH)..$(SLASH)..$(SLASH)DependenciesFiles$(SLASH)Eco.CalculatorA$(SLASH)SharedFiles \
-I ..$(SLASH)..$(SLASH)..$(SLASH)..$(SLASH)DependenciesFiles$(SLASH)Eco.CalculatorB$(SLASH)SharedFiles \
-I ..$(SLASH)..$(SLASH)..$(SLASH)..$(SLASH)DependenciesFiles$(SLASH)Eco.CalculatorD$(SLASH)SharedFiles \
-I ..$(SLASH)..$(SLASH)..$(SLASH)..$(SLASH)DependenciesFiles$(SLASH)Eco.CalculatorE$(SLASH)SharedFiles

# --- Linker Configuration ---
LIB_DIR = -L "$(ECO_FRAMEWORK)$(SLASH)Eco.Core1$(SLASH)BuildFiles$(SLASH)$(PLATFORM)$(SLASH)$(ARCH_TARGET)$(SLASH)StaticRelease" \
-L "$(ECO_FRAMEWORK)$(SLASH)Eco.InterfaceBus1$(SLASH)BuildFiles$(SLASH)$(PLATFORM)$(SLASH)$(ARCH_TARGET)$(SLASH)StaticRelease" \
-L "$(ECO_FRAMEWORK)$(SLASH)Eco.MemoryManager1$(SLASH)BuildFiles$(SLASH)$(PLATFORM)$(SLASH)$(ARCH_TARGET)$(SLASH)StaticRelease" \
-L "$(ECO_FRAMEWORK)$(SLASH)Eco.FileSystemManagement1$(SLASH)BuildFiles$(SLASH)$(PLATFORM)$(SLASH)$(ARCH_TARGET)$(SLASH)StaticRelease" \
-L "$(ECO_FRAMEWORK)$(SLASH)Eco.System1$(SLASH)BuildFiles$(SLASH)$(PLATFORM)$(SLASH)$(ARCH_TARGET)$(SLASH)StaticRelease"\
-L "..$(SLASH)..$(SLASH)..$(SLASH)BuildFiles$(SLASH)$(PLATFORM)$(SLASH)$(ARCH_TARGET)$(SLASH)$(BASE_TARGET)$(CONFIG_DIR)" \
-L "..$(SLASH)..$(SLASH)..$(SLASH)..$(SLASH)BuildFiles$(SLASH)$(PLATFORM)$(SLASH)$(ARCH_TARGET)$(SLASH)$(BASE_TARGET)$(CONFIG_DIR)"

# Компоненты-калькуляторы курса (статические библиотеки, DependenciesFiles). Юнит-тест сам
# регистрирует их в интерфейсной шине в обоих режимах; у A и C одинаковое имя файла (общий CID),
# поэтому библиотеки подключаются по полному пути
CALC_DIR = ..$(SLASH)..$(SLASH)..$(SLASH)..$(SLASH)DependenciesFiles
CALC_LIBS = $(CALC_DIR)$(SLASH)Eco.CalculatorA$(SLASH)BuildFiles$(SLASH)$(PLATFORM)$(SLASH)$(ARCH_TARGET)$(SLASH)StaticRelease$(SLASH)lib4828F6552E4540E78121EBD220DC360E.a \
            $(CALC_DIR)$(SLASH)Eco.CalculatorB$(SLASH)BuildFiles$(SLASH)$(PLATFORM)$(SLASH)$(ARCH_TARGET)$(SLASH)StaticRelease$(SLASH)libAE202E543CE54550899603BD70C62565.a \
            $(CALC_DIR)$(SLASH)Eco.CalculatorC$(SLASH)BuildFiles$(SLASH)$(PLATFORM)$(SLASH)$(ARCH_TARGET)$(SLASH)StaticRelease$(SLASH)lib4828F6552E4540E78121EBD220DC360E.a \
            $(CALC_DIR)$(SLASH)Eco.CalculatorD$(SLASH)BuildFiles$(SLASH)$(PLATFORM)$(SLASH)$(ARCH_TARGET)$(SLASH)StaticRelease$(SLASH)lib3A8E44677E82475CB4A3719ED8397E61.a \
            $(CALC_DIR)$(SLASH)Eco.CalculatorE$(SLASH)BuildFiles$(SLASH)$(PLATFORM)$(SLASH)$(ARCH_TARGET)$(SLASH)StaticRelease$(SLASH)lib872FEF1DE3314B87AD44D1E7C232C2F0.a

# Global Compiler Flags (-DECO_LINUX )
CCFLAGS = $(SYSROOT) -Wall $(CCFLAGS_BASE) $(CCFLAGS_ARCH) -DUGUID_UTILITY -DECO_LINUX $(LANG_STD_FLAGS) $(INC)

# Debug vs Release Flags
ifeq ($(DEBUG), 1)
    CCFLAGS += -g -DDEBUG
else
    CCFLAGS += -O2 -DNDEBUG
endif

ifeq ($(TARGET), 1)
    # Статические библиотеки ссылаются друг на друга (Eco.System1 -> шина, менеджер памяти),
    # поэтому для GNU ld они объединены в группу --start-group/--end-group
    LIBS_TARGET = -lm -lc -lgcc -ldl -Wl,--start-group -l00000000000000000000000042757331 -l0000000000000000000000004D656D31 -l00000000000000000000000046534D31 -l$(ECO_GEN_SYS_LIB) -lA2A2065C8C3B4926BC6C30A84CAA1B2F -l1EF402B8755C4289BBE1795A2F9385F6 $(CALC_LIBS) -Wl,--end-group
else
    # Eco.Lab2 и Eco.AdvancedMath загружаются системой Eco из $ECO_FRAMEWORK_RT (*.so)
    LIBS_TARGET = -lm -lc -lgcc -ldl -l$(ECO_GEN_SYS_LIB) $(CALC_LIBS)
endif

# Linker flags and Bare-metal libraries
LDFLAGS = $(SYSROOT) $(LDFLAGS_ARCH)
LIBS = $(LIB_DIR) $(LIBS_TARGET)
ifneq ($(TARGET), 1)
    # Динамическая компоновка: системная библиотека Eco.System1 из DynamicRelease,
    # которая загружает компоненты (*.so) через dlopen из каталога $ECO_FRAMEWORK_RT
    LIBS = -L "$(ECO_FRAMEWORK)$(SLASH)Eco.System1$(SLASH)BuildFiles$(SLASH)$(PLATFORM)$(SLASH)$(ARCH_TARGET)$(SLASH)DynamicRelease" $(LIB_DIR) $(LIBS_TARGET)
endif

# --- Source and Object Files ---
SRC_C = ..$(SLASH)..$(SLASH)..$(SLASH)UnitTestFiles$(SLASH)SourceFiles$(SLASH)EcoLab2.c
SRC_S = 

OBJ = $(SRC_C:.c=.o)
OBJS = $(SRC_S:.S=.o)

# --- Build Rules ---
.PHONY: all clean

all: $(OUT_DIR)$(SLASH)$(OUT_NAME)

# Compile C/C++ source files to object files
.c.o:
	@mkdir -p $(OUT_DIR)
	$(CC) $(CCFLAGS) -c $< -o $@

.S.o:
	@mkdir -p $(OUT_DIR)
	$(CC) $(CCFLAGS) -D__ASSEMBLY__ -c $< -o $@

$(OUT_DIR)$(SLASH)$(OUT_NAME): $(OBJ) $(OBJS)
	$(LINK_CC) $(LDFLAGS) $(if $(LDS_SCRIPT),-T$(LDS_SCRIPT),) -o $@ $(OBJ) $(OBJS) -Wl,-Map,$@.map $(LIBS)
	@$(RM) $(OBJ) $(OBJS)

clean:
	$(RM) $(OBJ) $(OBJS)
	$(RM) $(OUT_DIR)$(SLASH)$(OUT_NAME) $(OUT_DIR)$(SLASH)$(OUT_NAME).map
